import {useNavigate, useParams} from "react-router-dom";
import FormRenderer, {FormRendererProps} from "./FormRenderer";
import {useState, useCallback} from "react";
import templateServiceApi from "../../../api/service/templateServiceApi";
import {message} from "antd";
import {clearStorage, getAppId} from "../../../utils/Utils";
import CommonLoader from "../commonLoader/CommonLoader";
import ErrorComponent from "../Status/Error/ErrorStatus";
import SuccessComponent from "../Status/Success/Success";
import {IAssessment} from "../../../api/models/adminServiceApi-Interface";

const noJoinFields = [
  "passedToContactDetailsEin",
  "profileOthersContactEin",
  "suppliedCountries",
];

const FormRendererWrapper: React.FC<FormRendererProps> = props => {
  const {templateId} = useParams<{templateId: string}>();
  const navigate = useNavigate();

  const {
    onSubmit,
    selectedTemplate,
    toggleLoadingStatus,
    handleSuccessResponse,
    selectedMapId,
    draftId,
  } = props;

  const [selectedFormTemplate, setSelectedFormTemplate] = useState(
    selectedTemplate,
  ) as any;
  const [successResponse, setSuccessResponse] = useState({} as any);
  const [loading, setLoading] = useState<boolean>(false);
  const [formSubmissionStatus, setFormSubmissionStatus] = useState<
    boolean | null
  >(null);
  const [isFormSubmitted, setIsFormSubmitted] = useState<boolean>(false);

  const handleSelectedFormTemplateChange = useCallback((data: any) => {
    setSelectedFormTemplate(data);
  }, []);

  const handleLoadingStatus = useCallback((value: boolean) => {
    setLoading(value);
  }, []);

  const handleFormSubmit = async (form: any, status = "") => {
    const values = form.getFormState().values;
    console.log("values", values);
    try {
      let values;
      if (status == "draft") {
        values = form.values as any;
      } else {
        values = (await form.submit()) as any;
      }
      debugger;
      const attachments = JSON.parse(
        localStorage.getItem("attachments") || "[]",
      );
      const subscribers = localStorage.getItem("subscribers");
      const relatedItems = localStorage.getItem("relatedItems");

      const contacts = localStorage.getItem("passedToContactDetailsEin");
      const safeContacts =
        contacts && contacts !== "undefined" ? contacts : "[]";
      const passedToContactDetailsEin = JSON.parse(safeContacts);
      const othercontacts = localStorage.getItem("profileOthersContactEin");
      const othersafeContacts =
        othercontacts && othercontacts !== "undefined" ? othercontacts : "[]";
      const profileOthersContactEin = JSON.parse(othersafeContacts);
      const suppliedCountries = JSON.parse(
        localStorage.getItem("suppliedCountries") || "[]",
      );
      const suppliedEntities = JSON.parse(
        localStorage.getItem("suppliedEntities") || "[]",
      );

      try {
        setLoading(true);
        if (toggleLoadingStatus) {
          toggleLoadingStatus(true);
        }

        const responseArray: Array<{
          controlName: string;
          controlValue: any;
          controlType?: string;
        }> = Object.entries(values).map(([key, value]) => {
          if (Array.isArray(value) && !noJoinFields.includes(key)) {
            return {
              controlName: key,
              controlValue: value.join(", "),
            };
          }
          return {
            controlName: key,
            controlValue:
              value && typeof value === "object" && "ein" in value
                ? (value as {ein: string}).ein
                : value,
          };
        });

        // Only add if not already present in responseArray
        const extraFields = [
          {
            controlName: "passedToContactDetailsEin",
            controlValue: passedToContactDetailsEin,
            controlType: "multiselect",
          },
          {
            controlName: "profileOthersContactEin",
            controlValue: profileOthersContactEin,
            controlType: "multiselect",
          },
          {
            controlName: "suppliedCountries",
            controlValue: suppliedCountries,
            controlType: "multiselect",
          },
          {
            controlName: "suppliedEntities",
            controlValue: suppliedEntities,
            controlType: "multiselect",
          },
        ];

        let userId = "";
        if (getAppId() === 5) {
          responseArray.map(item => {
            if (item.controlName === "issueOwner") {
              userId = item.controlValue;
            }
          });
        }

        const responseBody = [...responseArray];
        extraFields.forEach(field => {
          if (
            !responseArray.some(item => item.controlName === field.controlName)
          ) {
            responseBody.push(field);
          }
        });

        console.log("responseBody", responseBody);

        responseArray.push({
          controlName: "suppliedEntities",
          controlValue: suppliedEntities,
          controlType: "multiselect",
        });

        const requestBody = {
          name: selectedFormTemplate?.name,
          userId: userId,
          status: status || "open",
          templateId: selectedFormTemplate.id,
          description: selectedFormTemplate.description,
          response: responseBody,
          attachments: attachments,
          subscribers: subscribers ? JSON.parse(subscribers) : [],
          relatedItems: relatedItems ? JSON.parse(relatedItems) : [],
          lobTemplateWorkflowMapId: selectedMapId, // need to change
          workflow: {
            metadataTemp: {
              formAction: "FormCreate",
            },
          },
        } as Partial<IAssessment>;

        if (draftId) {
          requestBody["id"] = draftId;
        }
        const response = await templateServiceApi.saveAssesment(requestBody);
        if (response.status === "OK") {
          const msg =
            status == "draft"
              ? "Draft request has been created successfully."
              : "Form submitted successfully!";
          message.success({
            content: msg,
            style: {textAlign: "right"},
          });
          setSuccessResponse(response.data);
          handleSuccessResponse?.(response.data);
          clearStorage();
          if (status == "draft") {
            navigate("/ratm/requests");
          } else {
            if (onSubmit) {
              onSubmit(true);
            }
            if (setFormSubmissionStatus) {
              setFormSubmissionStatus(true);
            }
          }
        } else {
          clearStorage();
          throw new Error("Failed to submit form");
        }
      } catch (error) {
        clearStorage();
        message.error({
          content: "Failed to submit form",
          style: {textAlign: "right"},
        });
        if (onSubmit) {
          onSubmit(false);
        }
        if (setFormSubmissionStatus) {
          setFormSubmissionStatus(false);
        }
      } finally {
        clearStorage();
        setLoading(false);
        if (toggleLoadingStatus) {
          toggleLoadingStatus(false);
        }
        setIsFormSubmitted(true);
      }
    } catch {
      message.error("Validation failed.");
    }
  };

  if (loading) return <CommonLoader />;

  if (!!templateId && isFormSubmitted && !formSubmissionStatus) {
    return <ErrorComponent />;
  } else {
    if (formSubmissionStatus) {
      return <SuccessComponent successResponse={successResponse} />;
    }
  }

  return (
    <FormRenderer
      {...props}
      templateId={templateId}
      onSubmitForm={handleFormSubmit}
      handleSelectedFormTemplateChange={handleSelectedFormTemplateChange}
      handleLoadingStatus={handleLoadingStatus}
    />
  );
};

export default FormRendererWrapper;

